# Local PDF/OCR and parsing rules. No separate inference model, service or API key.
# Never commit .env.
# Optional. Set this on Windows if tesseract.exe is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_FILE_MB=30
ROUNDING_TOLERANCE=0.02
MINIMUM_FIELD_CONFIDENCE=95
# Defaults to invoice_ai/config/local_data to preserve existing saved history.
# LOCAL_STORAGE_DIR=C:/InvoiceData
# Optional: set this if more than one mailbox in classic Outlook has an Invoices folder.
OUTLOOK_MAILBOX=
OUTLOOK_INVOICE_FOLDER=Invoices
# AUTO uses unambiguous dates in each document; unresolved dates require review.
# Set DMY or MDY only if that convention is confirmed for all incoming invoices.
INVOICE_DATE_ORDER=AUTO
